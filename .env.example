# =============================================================================
# CRM System Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# =============================================================================
# Database Configuration (PostgreSQL)
# =============================================================================
DATABASE_URL=postgresql+asyncpg://crm_user:password@db:5432/crm_db
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=password
POSTGRES_DB=crm_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# =============================================================================
# Elasticsearch Configuration
# =============================================================================
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200

# =============================================================================
# JWT Configuration (Architecture Section 8.1)
# =============================================================================
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# =============================================================================
# OAuth 2.0 - Google/Gmail (Architecture Section 7.1)
# =============================================================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/gmail/callback

# Gmail API Scopes (comma-separated)
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/gmail.send,https://www.googleapis.com/auth/gmail.modify

# =============================================================================
# Encryption Keys (Architecture Section 8.2)
# =============================================================================
# AES-256 encryption key for OAuth tokens (32 bytes, base64 encoded)
ENCRYPTION_KEY=your-32-byte-encryption-key-base64-encoded

# =============================================================================
# AI Service Configuration (Architecture Section 4.5)
# =============================================================================
# Choose: openai, gemini, or mock
AI_PROVIDER=mock

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4

# Google Gemini Configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-pro

# =============================================================================
# Email Configuration (Development)
# =============================================================================
# For local development, use Mailhog
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@crm.local

# =============================================================================
# Cloud Storage (Architecture Section 5.3)
# =============================================================================
# For local development, use local filesystem
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/app/storage

# For production, use GCS
# STORAGE_BACKEND=gcs
# GCS_BUCKET_NAME=your-bucket-name
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# =============================================================================
# Pub/Sub Configuration (Architecture Section 3)
# =============================================================================
# For local development, use Redis as message broker
PUBSUB_BACKEND=redis

# For production, use Google Cloud Pub/Sub
# PUBSUB_BACKEND=gcp
# GCP_PROJECT_ID=your-gcp-project-id

# =============================================================================
# Rate Limiting (Architecture Section 8.3)
# =============================================================================
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=150

# =============================================================================
# CORS Configuration (Architecture Section 8.3)
# =============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true

# =============================================================================
# Frontend Configuration
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# =============================================================================
# Logging Configuration (Architecture Section 11.3)
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# =============================================================================
# Environment
# =============================================================================
ENVIRONMENT=development
DEBUG=true

# =============================================================================
# Service Ports (for docker-compose)
# =============================================================================
GATEWAY_PORT=8000
AUTH_PORT=8001
EMAIL_SYNC_PORT=8002
CRM_PORT=8003
AI_PORT=8004
AUTOMATION_PORT=8005
ANALYTICS_PORT=8006
INTEGRATION_PORT=8007
FRONTEND_PORT=3000

# =============================================================================
# Health Check Configuration
# =============================================================================
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3

# =============================================================================
# Performance Configuration (Architecture Section 10.2)
# =============================================================================
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
CACHE_TTL_SECONDS=3600
